{
  "name": "OBV Typography",
  "description": "Typography system for Open Box Ventures LLP (OBV)",
  "roles": {
    "display": {
      "fontFamily": "Syne",
      "fallback": "sans-serif",
      "weights": [400, 500, 600, 700],
      "textTransform": "none",
      "usage": "Headlines / section titles, sentence case, tight tracking",
      "scale": { "xl": "clamp(44px, 7vw, 104px)", "lg": "clamp(32px, 5vw, 64px)", "md": "clamp(22px, 2.2vw, 30px)" }
    },
    "body": {
      "fontFamily": "Geist",
      "fallback": "sans-serif",
      "weights": [400, 500, 600],
      "usage": "Paragraphs / general copy",
      "scale": { "lg": "19px", "base": "16px", "sm": "14px" }
    },
    "utility": {
      "fontFamily": "Geist",
      "fallback": "sans-serif",
      "weights": [400, 500, 600],
      "usage": "Labels, captions, data. Sentence case, never tracked capitals",
      "scale": { "lg": "16px", "base": "14px", "sm": "13px", "xs": "12px" }
    }
  }
}
